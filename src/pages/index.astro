---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { PROFILE, ROBOTS, PROJECTS_IIT } from "../data/site";

const featured = PROJECTS_IIT.filter((p) => p.featured);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="pb-12 mt-5">
    <div class="text-xl py-1">Hi there 👋</div>
    <h1 class="text-5xl font-bold font-display">I'm {PROFILE.name}</h1>
    <p class="text-2xl py-3 font-semibold text-primary">{PROFILE.headline}</p>
    <p class="text-lg opacity-80">{PROFILE.where}</p>
    <p class="text-lg py-4 leading-relaxed">{PROFILE.intro}</p>
    <div class="alert bg-base-200 border-0 my-2">
      <span class="text-base">🗓️ {PROFILE.status}</span>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={`mailto:${PROFILE.email}`}>Say hello</a>
      <a class="btn btn-outline" href={PROFILE.cvResearch} target="_blank">Download CV</a>
      <a class="btn btn-ghost" href={PROFILE.scholar} target="_blank">Google Scholar ↗</a>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold font-display mb-4">Robots I've worked with 🤖</h2>
    <div class="flex flex-wrap gap-2">
      {ROBOTS.map((r) => <span class="badge badge-lg badge-outline py-4 px-4">{r}</span>)}
    </div>
  </section>

  <section>
    <h2 class="text-3xl font-bold font-display mb-2">Recent projects</h2>
    {
      featured.map((p) => (
        <>
          <HorizontalCard title={p.title} img={p.img} desc={p.desc} url={p.url} badge={p.badge} />
          <div class="divider my-0" />
        </>
      ))
    }
    <a class="btn btn-ghost mt-2" href="/projects">All projects →</a>
  </section>
</BaseLayout>
