---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import LinkedText from "../components/LinkedText.astro";
import { PROFILE, NEWS, PROJECTS_IIT } from "../data/site";

const featured = PROJECTS_IIT.filter((p) => p.featured);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="pb-12 mt-5">
    <h1 class="text-5xl font-bold font-display">{PROFILE.name}</h1>
    <p class="text-2xl py-3 font-semibold text-primary">{PROFILE.headline}</p>
    <p class="text-lg opacity-80"><LinkedText text={PROFILE.where} /></p>
    <div class="py-2">
      {PROFILE.intro.map((para) => <p class="text-lg py-2 leading-relaxed"><LinkedText text={para} /></p>)}
    </div>
    <div class="alert bg-primary/10 border-0 my-2">
      <span class="text-base">🗓️ {PROFILE.status}</span>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={`mailto:${PROFILE.email}`}>Say hello</a>
      <a class="btn btn-outline" href={PROFILE.cvResearch} target="_blank">Download CV</a>
      <a class="btn btn-ghost" href={PROFILE.scholar} target="_blank">Google Scholar ↗</a>
    </div>
  </section>

  {
    NEWS.length > 0 && (
      <section class="mb-12">
        <h2 class="text-3xl font-bold font-display mb-3">News</h2>
        <ul class="divide-y divide-base-300">
          {NEWS.map((n) => (
            <li class="flex flex-col sm:flex-row gap-1 sm:gap-6 py-3">
              <span class="sm:w-24 shrink-0 text-sm font-semibold text-secondary sm:pt-0.5">{n.date}</span>
              <span class="leading-relaxed">
                {n.text}
                {n.link && (
                  <a class="link link-primary ml-1 whitespace-nowrap" href={n.link} target="_blank">
                    {n.linkText ?? "More"} ↗
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2 class="text-3xl font-bold font-display mb-4">Recent projects</h2>
    <div class="flex flex-col gap-4">
      {featured.map((p) => <HorizontalCard title={p.title} img={p.img} full={p.full} desc={p.desc} url={p.url} badge={p.badge} />)}
    </div>
    <a class="btn btn-ghost mt-4" href="/projects">All projects →</a>
  </section>
</BaseLayout>
