---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { PROFILE, PROJECTS_IIT, PROJECTS_OZU } from "../data/site";

const groups = [
  { title: "At IIT, Genova", sub: "Dynamic Legged Systems lab, since 2023", items: PROJECTS_IIT },
  { title: "At Özyeğin University, Istanbul", sub: "Biomechatronics Lab, 2018–2022", items: PROJECTS_OZU },
];
---

<BaseLayout title="Projects | Sinan Emre" sideBarActiveItemID="projects">
  {
    groups.map((g, i) => (
      <section class={i ? "mt-12" : ""}>
        <h1 class="text-3xl font-bold font-display">{g.title}</h1>
        <p class="opacity-70 mb-4">{g.sub}</p>
        <div class="flex flex-col gap-4">
          {g.items.map((p) => <HorizontalCard title={p.title} img={p.img} full={p.full} desc={p.desc} url={p.url} badge={p.badge} />)}
        </div>
      </section>
    ))
  }
  <p class="mt-8 opacity-80">
    All papers are on <a class="link link-primary" href={PROFILE.scholar} target="_blank">Google Scholar</a>.
  </p>
</BaseLayout>
