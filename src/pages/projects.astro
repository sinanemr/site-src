---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { PROFILE, PROJECTS } from "../data/site";

// Group by year, newest first. The order inside a year follows site.ts.
const years = [...new Set(PROJECTS.map((p) => p.year))].sort((a, b) => b - a);
---

<BaseLayout title="Projects | Sinan Emre" sideBarActiveItemID="projects">
  <h1 class="text-3xl font-bold font-display mb-2">Projects</h1>
  {
    years.map((year) => (
      <section class="mt-4">
        <h2 class="text-right text-4xl font-bold font-display opacity-20 border-t border-base-300 pt-2 mb-2">{year}</h2>
        <div class="flex flex-col gap-4">
          {PROJECTS.filter((p) => p.year === year).map((p) => <HorizontalCard project={p} />)}
        </div>
      </section>
    ))
  }
  <p class="mt-8 opacity-80">
    All papers are on <a class="link link-primary" href={PROFILE.scholar} target="_blank">Google Scholar</a>.
  </p>
</BaseLayout>
